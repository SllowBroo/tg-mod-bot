# Скопируйте этот файл как .env и замените только значение BOT_TOKEN.
BOT_TOKEN=ВСТАВИТЬ_НОВЫЙ_ТОКЕН_ЗДЕСЬ

# Необязательно: если не задано, первая админ-команда привяжет текущую группу.
# Узнать ID можно командой !идентификатор после добавления бота.
ALLOWED_CHAT_ID=

# Для Bothost укажите /app/data/bot.db в панели переменных окружения.
DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO
COMMAND_COOLDOWN=1.0

